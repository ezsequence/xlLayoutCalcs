{
  "name": "xllayoutcalcs",
  "version": "0.3.1",
  "type": "module",
  "main": "./dist/xlcoords.cjs",
  "module": "./dist/xlcoords.mjs",
  "types": "./dist/xlcoords.d.ts",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/xlcoords.d.ts",
      "import": "./dist/xlcoords.mjs",
      "require": "./dist/xlcoords.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build:js": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --minify --tree-shaking=true --legal-comments=none --outfile=dist/xlcoords.mjs",
    "build:js:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=node --target=node18 --minify --tree-shaking=true --legal-comments=none --outfile=dist/xlcoords.cjs",
    "build:types": "pnpm exec dts-bundle-generator -o dist/xlcoords.d.ts src/index.ts",
    "build": "pnpm build:js && pnpm build:js:cjs && pnpm build:types"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  }
}
